<?xml version="1.0" encoding="utf-8"?><!--
   Disables device-to-device transfer and cloud backup on Android 12+.
   The app stores user session tokens and must not back them up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>