    <!-- About Screen -->
    <string name="about_title">حول TECH VISION DZ</string>
    <string name="about_description">التطبيق الرسمي لنظام أندرويد لـ TECH VISION DZ، وهي منصة تكنولوجية جزائرية تغطي أحدث أخبار التكنولوجيا والذكاء الاصطناعي والهواتف الذكية والبرمجيات والاتجاهات الرقمية.</string>
    <string name="about_website">الموقع الرسمي</string>
